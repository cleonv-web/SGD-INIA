<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<jsp:root xmlns:tiles="http://tiles.apache.org/tags-tiles" version="2.0" xmlns:jsp="http://java.sun.com/JSP/Page" xmlns:spring="http://www.springframework.org/tags">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <jsp:output omit-xml-declaration="yes"/>
    <spring:eval expression="@applicationProps['staticResourcesUrl']" var="iniaResourcesURL"/>
    <div id="headPanel">
        <div id="headPanel_top" class="sgd-header">
            <div class="sgd-header-logo">
                <img src="${iniaResourcesURL}/images/logo-inia.png" width="220" height="66" alt="INIA Instituto Nacional de Innovación Agraria"/>
            </div>
            <div id="titulo_interno">Sistema de Gesti&#243;n Documental</div>
            <div id="txt_nav">
                <span class="txt_nav2"><a href="#" onclick="fn_cambiaDependencia();">${usuarioConfig.deDep}</a></span>
                <br/>${usuario.dePrenombres} ${usuario.deApellidoPaterno} ${usuario.deApellidoMaterno}
            </div>
            <div class="sgd-header-exit">
                <a href="#" id="main_links" onclick="salir('${ctx}/index.jsp')">
                    <strong>Salir</strong><img src="${resourceURL}/images/icon_exit01.png" border="0" alt="Salir del Sistema" name="exit" width="40" height="40"/>
                </a>
            </div>
        </div>
    </div>
</jsp:root>
