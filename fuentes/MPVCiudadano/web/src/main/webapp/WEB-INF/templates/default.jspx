<html lang="es" xmlns:jsp="http://java.sun.com/JSP/Page"
xmlns:c="http://java.sun.com/jsp/jstl/core" 
xmlns:tiles="http://tiles.apache.org/tags-tiles" 
xmlns:spring="http://www.springframework.org/tags" xmlns:util="urn:jsptagdir:/WEB-INF/tags/util" >  
    <jsp:directive.page contentType="text/html;charset=UTF-8" />
    <jsp:directive.page pageEncoding="UTF-8" />                                                                                                                                 
    <jsp:directive.page session="false"/>
    <jsp:output omit-xml-declaration="yes"/> 
    <jsp:output doctype-root-element="HTML" doctype-system="about:legacy-compat" />
    <c:set var="ctx" value="${pageContext.request.contextPath}" scope="request" />
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="description" content="Presenta tus documentos al Instituto Nacional de Innovación Agraria. Mesa de Partes Digital de INIA."/>
        <meta name="theme-color" content="#183e31"/>
        <link rel="shortcut icon" href="${ctx}/favicon.ico"/>
        
        <util:load-scripts />
    <title>
        Mesa de Partes Digital | INIA
    </title>
    </head>
    <body>
        <div id="page">
            <tiles:insertAttribute name="header" ignore="true" />
            <tiles:insertAttribute name="body" ignore="true" />
            <tiles:insertAttribute name="footer" ignore="true" />
        </div>
    </body>
</html>
