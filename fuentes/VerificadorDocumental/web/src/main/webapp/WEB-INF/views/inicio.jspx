<jsp:root xmlns:tiles="http://tiles.apache.org/tags-tiles" version="2.0" xmlns:c="http://java.sun.com/jsp/jstl/core"
          xmlns:jsp="http://java.sun.com/JSP/Page" xmlns:spring="http://www.springframework.org/tags"
          xmlns:form="http://www.springframework.org/tags/form">
    <!--jsp:directive.page contentType="text/html;charset=ISO-8859-1"/-->
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <jsp:output omit-xml-declaration="yes"/>
    <spring:eval expression="@applicationProps['application.version']" var="applicationVersion" scope="request"/>
    <spring:eval expression="@applicationProps['resources.version']" var="resourceVersion"/>
    <c:set var="resourceURL" value="resources-${resourceVersion}" scope="request"/>
    <spring:eval expression="@applicationProps['B64_IMG_HEADER']" var="b64ImgHeader"/>
    <c:set var="b64ImgHeader" value="${b64ImgHeader}" scope="request"/>

    <tiles:insertTemplate template="/WEB-INF/templates/default.jspx" flush="true">
        <tiles:putAttribute name="title" value=":Inicio"/>
        <tiles:putAttribute name="body">
            <script languaje="javascript">jQuery(document).ready(function () {
                    navegador();
                    $("#textoCaptcha").val("");
                    jQuery("#divPDF").hide();
                    jQuery("#anexosDiv").hide();
                    $("#tipoDoc").change(function() {
                        $("#numDoc").val("");
                        $("#claveAccesoDoc").val("");
                        $("#textoCaptcha").val("");
                    });
                });
            </script>
              <header  class="header nav-default">
                <div  class="container clearfix">
                    <div  class="row nav-default__wrapper px-4 justify-between">
                        <div  class="col-xs-4 col-sm-5 col-md-9 px-0">
                            <a  href="#" class="logo"><div _ngcontent-bwn-c27="" class="home__logo__img_shield--small md:hidden">
                                    <img  alt="" role="img" src="" class="h-10"/>
                                </div>
                                <div  class="home__logo__img--small">
                                    <img  alt="" role="img" src="data:image/svg+xml;base64," 
                                         class="img-logo" />
                                    <img  alt="" role="img" src="data:image/svg+xml;base64," 
                                         class="d-none img-logo-focus"/>
                                </div>
                                <div  class="tagline hidden-md-and-down">
                                    <div  class="gobpe__text tagline__text">VERIFICACIÓN DE DOCUMENTOS FIRMADOS DIGITALMENTE</div></div></a></div>
                                    <div  class="col-xs-8 col-sm-6 col-md-3 px-0"><div _ngcontent-bwn-c27="" class="search-internal"></div>                                    
                        </div></div></div>
            </header>
            <div id="dlglogin_principal" style="box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;">
                <!-- Nuevo (Ini) -->
                <div class="pseudoTable">
                    <div class="neoHead">
                        <img class="imgW100" src="data:image/png;base64,${b64ImgHeader}" width="1200" height="180"/>
                    </div>
                    <!--<div class="">
                        <div id="titulo_servicios" class="csTit">
                            VERIFICACIÓN DE DOCUMENTOS FIRMADOS DIGITALMENTE
                        </div>
                    </div>-->
                    <div class="contentLevel1">
                        <fieldset>
                            <legend>Verificación de Documentos </legend>
                            <div class="neoContent container">
                                <div class="row">
                                    <div id="divVerifica" class="neoLeft col-md-12" style="margin: 0;">
                                        <!-- mainDiv (Ini) -->
                                        <div id="mainDiv">
                                            <form:form name="mainForm" modelAttribute="verificaDocBean">
                                            <form:input path="cookieSessionId"  name="cookieSessionId" type="hidden" />    
                                                <div id="dlglogin">
                                                    <div class="clearer">
                                                        <![CDATA[&nbsp;]]>
                                                    </div>
                                                    <div class="filaCs">
                                                        <div class="celdaTitulo subti_noti">
                                                            <div class="padd_5_10">Tipo de Documento :</div>
                                                        </div>
                                                        <div class="celdaImput">
                                                            <form:select path="tipoDoc" class="wimp_500">
                                                                <form:options items="${listaTipoDoc}" itemValue="coTipDoc" itemLabel="deTipDoc" />
                                                            </form:select><a href="#" data-toggle="tooltip" class="tooltipObligatorio" title="Campo Obligatorio">(*)</a>
                                                        </div>
                                                        <div class="celdaAsterix">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="clearer">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                    </div>
                                                    <div class="filaCs">
                                                        <div class="celdaTitulo subti_noti">
                                                            <div class="padd_5_10">Número de Documento : </div>
                                                        </div>
                                                        <div class="celdaImput">
                                                            <form:input path="numDoc" 
                                                                        maxlength="100"
                                                                        id = "numDoc"
                                                                        class="input ui-corner-all wimp_500"
                                                                        title ="Ingrese número de documento"
                                                                        required="true"
                                                                        tabindex="1"
                                                                        onkeypress="return fu_onKeyPressFiltrarTecladoCadena(event, false, public_num_doc);"
                                                                        /><a href="#" data-toggle="tooltip" class="tooltipObligatorio" title="Campo Obligatorio">(*)</a>
                                                        </div>
                                                        <div class="celdaAsterix">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="clearer">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                    </div>
                                                    <div class="filaCs">
                                                        <div class="celdaTitulo subti_noti">
                                                            <div class="padd_5_10">Código de Verificación : </div> 
                                                        </div>
                                                        <div class="celdaImput">
                                                            <form:input path="claveAccesoDoc" 
                                                                        maxlength="7"
                                                                        id = "claveAccesoDoc"
                                                                        class="input ui-corner-all wimp_500"
                                                                        title ="Ingrese código de verificación"
                                                                        required="true"
                                                                        tabindex="2"
                                                                        onkeypress="return fu_onKeyPressFiltrarTecladoCadena(event, false, public_alpha_numeric);"
                                                                        /><a href="#" data-toggle="tooltip" class="tooltipObligatorio" title="Campo Obligatorio">(*)</a>
                                                        </div>
                                                        <div class="celdaAsterix">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="clearer">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                    </div>

                                                    <!-- -->
                                                    <div class="filaCs">
                                                        <div class="celdaTitulo subti_noti">
                                                            <div class="padd_5_10">Ingrese texto : </div> 
                                                        </div>
                                                        <div class="celdaImput">
                                                            <div class="perc95">
                                                                <div class="perc50">
                                                                    <form:input path="textoCaptcha"
                                                                            type="text"
                                                                            maxlength="5"
                                                                            title ="Ingrese texto de la imagen"
                                                                            id="textoCaptcha"
                                                                            class="input ui-corner-all wimp_captcha"
                                                                            tabindex="3"
                                                                            /><a href="#" data-toggle="tooltip" class="tooltipObligatorio" title="Campo Obligatorio">(*)</a>
                                                                </div>
                                                                <div class="perc50">
                                                                    <div class="celdaImputSp force100">
                                                                        <div class="input-group groupWimpSp"><!--225-->
                                                                            <img class="imgCapt" style="width: 80%;" id="imagenCaptcha" src="jcaptcha" />                                                                            
                                                                            <span class="input-group-btn">
                                                                                <button class="btn btn-default" style="vertical-align: middle;  border:none; border-left: 0px;"
                                                                                        type="button" title ="Actualizar imagen" onclick="recargarCaptcha();">
                                                                                    <span class="glyphicon glyphicon-refresh" onclick="recargarCaptcha();"><jsp:text/></span>
                                                                                </button>
                                                                            </span>
                                                                        </div>  
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="celdaAsterix">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="clearer">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                    </div>
                                                    <!-- -->

                                                    <div class="filaCs">
                                                        <div class="celdaAsterix">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="clearer noDisplay">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                    </div>
                                                    <div class="filaCs2">
                                                        <div class="celdaTitulo subti_noti noDisplay">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="celdaImput">
                                                            <button title ="Ver Documento" class="btn btn-default btn-lg" onclick="submitAjaxFormVerifica();" type="button">
                                                                <span class="glyphicon glyphicon-list-alt"><jsp:text/></span> Ver Documento</button>
                                                        </div>

                                                        <div class="celdaAsterix noDisplay">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                        <div class="clearer noDisplay">
                                                            <![CDATA[&nbsp;]]>
                                                        </div>
                                                    </div>


                                                </div>
                                            </form:form>
                                            <div>
                                                <div style="text-align: right;">
                                                    <div class="tooltipObligatorio">(*) Campo Obligatorio</div> 
                                                </div>
                                            </div>

                                        </div>
                                        <!-- mainDiv (Fin) -->
                                    </div>
                                    <!--<div id="anexosDiv" class="neoRight col-md-5" style="margin: 0;">
                                        <div>
                                            <jsp:directive.include file="anexos.jspx"/>    
                                        </div>
                                    </div>-->
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="contentLevel2">
                        <div class="neoContent container">
                            <div class="row">
                                <div class="neoDoc col-xs-12">
                                    <![CDATA[&nbsp;]]>
                                    <div id="divPDF" >
                                        <div>
                                            <jsp:directive.include file="visorPDF.jspx"/>    
                                        </div>
                                    </div>
                                    <div class="">
                                        <![CDATA[&nbsp;]]>
                                    </div>    
                                    <div style="text-align: center;">
                                        <div>Versión ${applicationVersion}</div> 
                                    </div>
                                    <div class="">
                                        <![CDATA[&nbsp;]]>
                                    </div>    
                                </div>
                            </div>
                        </div>          
                    </div>
                </div>
            </div>

            <div id="loadding" class="box" style="display: none"><div class="image"><img align='absmiddle' src='${resourceURL}/images/loading.gif'/><jsp:text/></div><div class="line1">PROCESANDO</div><div class="line2">Ejecutando petición, por favor espere</div></div>

        </tiles:putAttribute>
    </tiles:insertTemplate>
</jsp:root>