<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" xmlns:c="http://java.sun.com/jsp/jstl/core" version="2.0">
    <jsp:directive.page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"/>
    <jsp:output omit-xml-declaration="yes"/>
    <article id="dlglogin_principal" class="expediente-result" aria-labelledby="result-title">
        <header class="result-heading">
            <div>
                <p class="eyebrow">SEGUIMIENTO DE EXPEDIENTES</p>
                <h2 id="result-title">Expediente <c:out value="${docExpediente.nroExpediente}"/></h2>
                <p class="result-subtitle">Información de registro y situación actual en el INIA.</p>
            </div>
            <div class="result-status" aria-label="Estado del expediente">
                <span>Estado actual</span>
                <strong id="rptLblEstadoDocumento"><c:out value="${empty docExpediente.estado ? 'Sin estado registrado' : docExpediente.estado}"/></strong>
            </div>
        </header>
        <section class="result-office" aria-labelledby="office-title">
            <div class="office-symbol" aria-hidden="true">→</div>
            <div>
                <h3 id="office-title"><c:out value="${empty docExpediente.oficinaAtencion ? 'Oficina de registro' : 'Oficina en atención'}"/></h3>
                <p id="rptLblOficinaAtencion"><c:out value="${not empty docExpediente.oficinaAtencion ? docExpediente.oficinaAtencion : (not empty docExpediente.oficinaRegistro ? docExpediente.oficinaRegistro : 'Sin oficina registrada')}"/></p>
                <c:if test="${not docExpediente.tieneDerivacion}">
                    <p class="office-note">No hay una derivación vigente registrada. La oficina indicada corresponde al registro del expediente.</p>
                </c:if>
            </div>
        </section>
        <section class="result-data" aria-labelledby="data-title">
            <h3 id="data-title">Datos del registro</h3>
            <dl class="result-grid">
                <div><dt>Fecha y hora de registro</dt><dd id="rptLblFechaRegistro"><c:out value="${empty docExpediente.fechaExpediente ? 'No registrada' : docExpediente.fechaExpediente}"/></dd></div>
                <div><dt>Tipo de documento</dt><dd id="rptLblTipoDocumento"><c:out value="${empty docExpediente.tipoDocumento ? 'No registrado' : docExpediente.tipoDocumento}"/></dd></div>
                <div><dt>Número de documento</dt><dd id="rptLblNroDocumento"><c:out value="${empty docExpediente.nroDoc ? 'Sin número registrado' : docExpediente.nroDoc}"/></dd></div>
                <div><dt>Institución del remitente</dt><dd id="rptLblInstitucion"><c:out value="${empty docExpediente.institucion ? 'No registrada' : docExpediente.institucion}"/></dd></div>
                <div><dt>Remitente</dt><dd id="rptLblRemitente"><c:out value="${empty docExpediente.remitente ? 'No registrado' : docExpediente.remitente}"/></dd></div>
                <div><dt>Folios</dt><dd id="rptLblFolios"><c:out value="${empty docExpediente.folios ? 'No registrados' : docExpediente.folios}"/></dd></div>
            </dl>
        </section>
        <section class="result-content" aria-labelledby="subject-title">
            <h3 id="subject-title">Sumilla</h3>
            <p id="rptLblSumilla" class="result-prose"><c:out value="${empty docExpediente.sumilla ? 'Sin sumilla registrada.' : docExpediente.sumilla}"/></p>
        </section>
        <div class="result-notes">
            <section aria-labelledby="notes-title">
                <h3 id="notes-title">Observaciones del registro</h3>
                <p id="rptLblObservaciones" class="result-prose"><c:out value="${empty docExpediente.observacion ? 'Sin observaciones registradas.' : docExpediente.observacion}"/></p>
            </section>
            <section aria-labelledby="closing-title">
                <h3 id="closing-title">Observaciones de atención o archivado</h3>
                <p id="rptLblObservacionFinalizar" class="result-prose"><c:out value="${empty docExpediente.obsFinalizar ? 'Sin observaciones de atención o archivado registradas.' : docExpediente.obsFinalizar}"/></p>
            </section>
        </div>
        <footer class="result-footer">
            <p>La recepción del documento no implica conformidad con su contenido.</p>
            <a href="${pageContext.request.contextPath}/inicio.do">Consultar otro expediente <span aria-hidden="true">↗</span></a>
        </footer>
    </article>
</jsp:root>
