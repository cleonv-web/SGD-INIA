<jsp:root xmlns:tiles="http://tiles.apache.org/tags-tiles" version="2.0" xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:jsp="http://java.sun.com/JSP/Page" xmlns:spring="http://www.springframework.org/tags" xmlns:form="http://www.springframework.org/tags/form">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <jsp:output omit-xml-declaration="yes"/>
    <c:set var="ctx" value="${pageContext.request.contextPath}" scope="request"/>
    <spring:eval expression="@applicationProps['application.version']" var="applicationVersion" scope="request"/>
    <spring:eval expression="@applicationProps['resources.version']" var="resourceVersion"/>
    <c:set var="resourceURL" value="resources-${resourceVersion}" scope="request"/>
    <tiles:insertTemplate template="/WEB-INF/templates/default.jspx" flush="true">
        <tiles:putAttribute name="title" value=""/>
        <tiles:putAttribute name="body">
            <div class="government-bar"><div class="wrap"><span class="peru-mark">PERÚ · Instituto Nacional de Innovación Agraria</span><span>Servicios digitales para la ciudadanía</span></div></div>
            <header class="site-header"><div class="wrap header-inner">
                <a class="brand" href="${ctx}/inicio.do" aria-label="INIA, inicio de consulta"><img src="${resourceURL}/images/inia-logo.png" alt="INIA — Instituto Nacional de Innovación Agraria" width="207" height="62"/></a>
                <div class="service-label"><strong>Consulta de trámites</strong>Gestión documental</div>
                <nav class="site-nav" aria-label="Servicios ciudadanos"><a href="${ctx}/inicio.do" class="current" aria-current="page">Consulta de expediente</a><a href="${ctx}/../mpd/inicio.do">Mesa de partes</a><a href="#ayuda" class="nav-external">Ayuda <span aria-hidden="true">↗</span></a></nav>
            </div></header>
            <main class="wrap">
                <nav class="breadcrumb" aria-label="Ubicación"><a href="${ctx}/inicio.do">Servicios digitales</a><span aria-hidden="true">/</span><span>Consulta de expediente</span></nav>
                <section class="hero" aria-labelledby="page-title">
                    <div class="hero-story"><div class="hero-copy">
                        <div class="eyebrow">INIA a tu servicio</div>
                        <h1 id="page-title">Tu trámite,<br/><span>más cerca de ti.</span></h1>
                        <p class="hero-description">Consulta el estado de tu expediente y conoce la oficina que lo está atendiendo. Toda la información, en un solo lugar.</p>
                    </div><div class="hero-photo" role="img" aria-label="Sede del Instituto Nacional de Innovación Agraria"><div class="photo-caption"><div>Innovación agraria al servicio del país<small>INSTITUTO NACIONAL DE INNOVACIÓN AGRARIA</small></div></div></div></div>
                    <div class="form-panel" id="divVerifica">
                        <div class="form-kicker">SEGUIMIENTO DE EXPEDIENTES <span class="glyphicon glyphicon-file" aria-hidden="true"><jsp:text/></span></div>
                        <h2>Consulta tu expediente</h2>
                        <p class="form-description">Ten a la mano el número que figura en tu cargo de recepción.</p>
                        <div id="mainDiv">
                            <form:form name="mainForm" modelAttribute="consultaDocBean" onsubmit="return submitAjaxFormVerifica();">
                                <form:input path="cookieSessionId" type="hidden"/>
                                <input type="hidden" id="captchaToken" name="captchaToken" value=""/>
                                <div class="field">
                                    <label for="claveAccesoDoc">Número de expediente <span class="required" aria-hidden="true">*</span></label>
                                    <form:input path="nroExpediente" id="claveAccesoDoc" maxlength="70" placeholder="Ej. 2026-000001" autocomplete="off" required="true" aria-describedby="expediente-hint expediente-error"/>
                                    <small id="expediente-hint">Ingresa el número completo, incluyendo el año.</small><span class="field-error" id="expediente-error"><jsp:text/></span>
                                </div>
                                <div class="field">
                                    <label for="textoCaptcha">Código de seguridad <span class="required" aria-hidden="true">*</span></label>
                                    <div class="captcha-row"><div class="captcha-image"><img id="imagenCaptcha" alt="Código de seguridad de cinco caracteres" width="220" height="76"/></div><button id="refreshCaptcha" class="refresh-button" type="button" onclick="recargarCaptcha();" aria-label="Generar otro código de seguridad" title="Generar otro código"><span class="glyphicon glyphicon-refresh" aria-hidden="true"><jsp:text/></span></button></div>
                                    <p class="captcha-status" id="captcha-status" role="status"><jsp:text/></p>
                                    <form:input path="textoCaptcha" id="textoCaptcha" maxlength="5" placeholder="Escribe los 5 caracteres de la imagen" autocomplete="off" required="true" aria-describedby="captcha-hint captcha-error"/>
                                    <small id="captcha-hint">Si no distingues el código, genera uno nuevo con el botón ↻.</small><span class="field-error" id="captcha-error"><jsp:text/></span>
                                </div>
                                <div id="form-alert" class="form-alert" role="alert"><jsp:text/></div>
                                <button id="searchExpediente" class="primary-button" type="submit" disabled="disabled"><span class="glyphicon glyphicon-search" aria-hidden="true"><jsp:text/></span><span id="search-label">Consultar expediente</span><span aria-hidden="true">→</span></button>
                                <p class="form-note">Los campos marcados con * son obligatorios.</p>
                            </form:form>
                        </div>
                    </div>
                </section>
                <section id="divPDF" class="result-section" aria-label="Resultado de la consulta" aria-live="polite" aria-atomic="true" tabindex="-1"><jsp:text/></section>
                <section class="guide" aria-label="Cómo consultar tu expediente">
                    <div class="guide-item"><span class="step-number">01</span><div><h3>Encuentra tu número</h3><p>Ubícalo en el cargo de recepción de tu trámite.</p></div></div>
                    <div class="guide-item"><span class="step-number">02</span><div><h3>Completa la verificación</h3><p>Escribe los cinco caracteres de la imagen de seguridad.</p></div></div>
                    <div class="guide-item"><span class="step-number">03</span><div><h3>Revisa el estado</h3><p>Conoce la situación de tu trámite y la oficina responsable.</p></div></div>
                </section>
                <section class="help-section" id="ayuda" aria-labelledby="help-title"><div><div class="eyebrow">Te orientamos</div><h2 id="help-title">¿Necesitas ayuda?</h2><p>Resuelve las dudas más frecuentes antes de realizar tu consulta.</p></div><div class="faq">
                    <details><summary>¿Dónde encuentro mi número de expediente?</summary><p>Revisa el cargo o la constancia de recepción que recibiste al presentar tu documento. Copia el número completo tal como aparece en ese documento.</p></details>
                    <details><summary>¿Qué hago si mi expediente no aparece?</summary><p>Verifica el número y vuelve a consultar con un nuevo código de seguridad. Si el problema continúa, contacta a la mesa de partes del INIA y ten a la mano tu cargo de recepción.</p></details>
                    <details><summary>¿Cómo presento un nuevo documento?</summary><p>Puedes ingresar a la <a href="${ctx}/../mpd/inicio.do">Mesa de Partes Virtual</a> para presentar tu documento ante el INIA.</p></details>
                </div></section>
            </main>
            <footer class="site-footer"><div class="wrap footer-inner"><div><strong>Instituto Nacional de Innovación Agraria</strong>Sistema de Gestión Documental · Consulta ciudadana</div><div class="footer-links"><a href="${ctx}/../mpd/inicio.do">Mesa de Partes Virtual ↗</a><span>SGD ${applicationVersion}</span></div></div></footer>
            <div id="loadding" class="box" style="display:none"><div class="line1">Consultando expediente</div></div>
        </tiles:putAttribute>
    </tiles:insertTemplate>
</jsp:root>
